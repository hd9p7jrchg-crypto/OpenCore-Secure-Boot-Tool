# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.Desktop.ini
.DS_Store

# Generated keys and certificates (contains private keys!)
keys/*.key
keys/*.pem
keys/*.esl
keys/*.auth
keys/*.p7
keys/*.crt

# Generated certificates
certs/*.esl
certs/*.p7
certs/*.auth
certs/*.crt
certs/*.pem

# Signed files
signed/

# Extracted files
extracted/

# Logs
*.log

# Keep directory structure
!keys/.gitkeep
!certs/.gitkeep
